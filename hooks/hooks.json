{
  "description": "Name the session from the conversation so far (SessionStart + UserPromptSubmit, both async).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rename-session.sh\"",
            "async": true,
            "timeout": 120,
            "statusMessage": "Naming session..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rename-session.sh\"",
            "async": true,
            "timeout": 120,
            "statusMessage": "Naming session..."
          }
        ]
      }
    ]
  }
}
